# Copy to .env and fill in from Firebase console > Project settings > Your apps > Web app.
# Leave blank to run in guest mode (checklists saved in this browser only, no code sharing).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: the public URL of the deployed app, used in "join" links sent by text/email.
# Defaults to the page the app is running on. Set it for Capacitor builds.
VITE_PUBLIC_APP_URL=
